default_platform(:android)

# Release is driven by a git tag "vX.Y.Z". versionName comes from the tag; versionCode is the
# next free code on the Play Internal track. This app publishes a signed APK (not AAB) and is
# NOT enrolled in Play App Signing — the APK is signed solely with our keystore. The APK is
# uploaded as a DRAFT (manual publish in Play Console). Signing uses keystore.properties
# (restored on CI from secrets).
platform :android do
  desc "Build a signed APK from the current git tag and upload to Play Internal (draft)"
  lane :release_from_tag do
    tag = ENV["RELEASE_TAG"] || `git describe --tags --abbrev=0`.strip
    version_name = tag.sub(/^v/, "")
    UI.user_error!("Could not derive a version from tag '#{tag}'") if version_name.empty?

    version_code = begin
      google_play_track_version_codes(track: "internal").max.to_i + 1
    rescue
      1
    end

    gradle(
      task: ":androidApp:assembleRelease",
      project_dir: "..",
      properties: {
        "appVersionName" => version_name,
        "appVersionCode" => version_code,
        "appBuildType" => "release",
      },
    )

    upload_to_play_store(
      track: "internal",
      release_status: "draft",
      apk: "../androidApp/build/outputs/apk/release/androidApp-release.apk",
      skip_upload_aab: true,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
    )
  end

  desc "Build a signed APK with an explicit version and upload to Play Internal (draft). " \
       "Usage: fastlane android internal version_name:0.2.0 [version_code:47]"
  lane :internal do |options|
    version_name = options[:version_name]
    UI.user_error!("Pass version_name, e.g. `fastlane android internal version_name:0.2.0`") if version_name.to_s.empty?

    version_code = options[:version_code] || begin
      google_play_track_version_codes(track: "internal").max.to_i + 1
    rescue
      1
    end

    gradle(
      task: ":androidApp:assembleRelease",
      project_dir: "..",
      properties: {
        "appVersionName" => version_name,
        "appVersionCode" => version_code,
        "appBuildType" => "release",
      },
    )

    upload_to_play_store(
      track: "internal",
      release_status: "draft",
      apk: "../androidApp/build/outputs/apk/release/androidApp-release.apk",
      skip_upload_aab: true,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
    )
  end
end
