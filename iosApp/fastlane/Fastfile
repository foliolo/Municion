default_platform(:ios)

# Tag-driven TestFlight release. versionName from the tag; CFBundleVersion auto-incremented from
# the latest TestFlight build. Signing via `match` (read-only) against a private certs repo.
# Requires the Firebase / GoogleMobileAds / RevenueCat SPM packages already added to the Xcode
# project, and GoogleService-Info.plist committed (see MIGRATION_REPORT phase 11).
platform :ios do
  desc "Build a signed .ipa from the current git tag and upload to TestFlight"
  lane :release_from_tag do
    tag = ENV["RELEASE_TAG"] || `git describe --tags --abbrev=0`.strip
    version = tag.sub(/^v/, "")

    # Pre-build the Kotlin framework (release flavor).
    sh("cd .. && ./gradlew :shared:linkReleaseFrameworkIosArm64 -PappBuildType=release")

    app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_API_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_API_KEY_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_API_KEY_BASE64"],
      is_key_content_base64: true,
    )

    match(type: "appstore", readonly: true)

    increment_version_number(version_number: version, xcodeproj: "iosApp.xcodeproj")
    latest = (latest_testflight_build_number(version: version) rescue 0)
    increment_build_number(build_number: (latest + 1).to_s, xcodeproj: "iosApp.xcodeproj")

    gym(scheme: "iosApp", export_method: "app-store", project: "iosApp.xcodeproj")
    pilot(skip_waiting_for_build_processing: true)
  end
end
