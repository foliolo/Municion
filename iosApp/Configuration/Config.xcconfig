// TEAM_ID must be your real Apple Developer Team ID (Developer Portal → Membership).
// Verify this value before archiving — it drives signing/provisioning.
TEAM_ID=3NXH5U7C5A

PRODUCT_NAME=Municion
// Must match the bundle id registered in Firebase / AdMob / App Store Connect / RevenueCat.
// (The JetBrains wizard default appended $(TEAM_ID) for free provisioning; removed so the
// real backend config — GoogleService-Info.plist, AdMob, Fastlane — resolves correctly.)
PRODUCT_BUNDLE_IDENTIFIER=al.ahgitdevelopment.municion

// Required by Google Sign-In. Keep it in sync with REVERSED_CLIENT_ID from
// iosApp/GoogleService-Info.plist.
GOOGLE_REVERSED_CLIENT_ID=com.googleusercontent.apps.522449412724-pf4fl4rl2f3fpeae69b2k0qcuhdio69c

CURRENT_PROJECT_VERSION=2
MARKETING_VERSION=0.2.0

// Simulator builds don't need code signing. Disabling it here stops the Kotlin framework
// embed/sign phase (:shared:embedAndSignAppleFrameworkForXcode) from failing on the simulator once
// the distribution certificate is installed (it would otherwise try to sign the framework with an
// identity that isn't valid for the simulator). Device (iphoneos) signing is untouched, so
// TestFlight/App Store archives are unaffected.
CODE_SIGNING_ALLOWED[sdk=iphonesimulator*] = NO
